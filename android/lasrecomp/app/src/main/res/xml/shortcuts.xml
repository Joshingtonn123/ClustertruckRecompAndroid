<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: back to the system's Vulkan driver without opening the app first (a custom driver that
     draws garbage, or never draws, leaves Settings out of reach). ClustertruckRecompActivity.SYSTEM_DRIVER. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="system_driver"
        android:enabled="true"
        android:icon="@drawable/ic_clustertruck"
        android:shortcutShortLabel="@string/shortcut_system_driver"
        android:shortcutLongLabel="@string/shortcut_system_driver_long">
        <intent
            android:action="com.clustertruck.recomp.action.SYSTEM_DRIVER"
            android:targetPackage="com.clustertruck.recomp"
            android:targetClass="com.lasrecomp.LASRecompActivity" />
    </shortcut>
</shortcuts>
